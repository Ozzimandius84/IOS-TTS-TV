.DS_Store
node_modules/
__pycache__/
*.pyc
.pytest_cache/

# The Rust build output. The PROJECT is source; the target tree is not.
src-tauri/target/

# Generated by `tauri android init`, whole, and not in this repo: there is
# nothing in it a human wrote. `tools/android_permissions.py` is the one edit
# it needs, and it is a script precisely so the file itself need not be kept.
# (gen/apple/ is the opposite case and IS tracked -- see PHONE.md.)
src-tauri/gen/android/

# tauri-build's, and CocoaPods'. Everything else under gen/apple/ is tracked:
# project.yml is the file xcodegen rewrites the others FROM, and it is where
# the signing team and the two microphone strings live.
src-tauri/gen/schemas/
src-tauri/gen/apple/Pods/
src-tauri/gen/apple/Podfile.lock

# NEVER, in any form. A book is not part of the app.
**/book-data.js
**/book.json
books/

# This shell cannot delete files inside the repo, so anything the old layout
# leaves behind is MOVED here and Osca empties it. Never committed: the old
# published shell it holds is already in this repo's history at `04f546e`
# ("publish shell"), so carrying a second copy would be noise.
_to_delete/
