{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Frank",
  "version": "0.1.0",
  "identifier": "com.ttstv.frank",
  "build": {
    "frontendDist": "../shell",
    "beforeBuildCommand": "python3 tools/prebuild.py",
    "beforeDevCommand": "python3 tools/prebuild.py --dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "frank-pair",
            "com.googleusercontent.apps.831378567000-50bh7p37g80gssem6dq3l1f8ncj2j2o2"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "frank-pair"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
