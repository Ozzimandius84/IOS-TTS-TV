{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Frank",
  "version": "0.1.0",
  "identifier": "com.ttstv.frank",
  "build": {
    "frontendDist": "../shell",
    "beforeBuildCommand": "python3 tools/prebuild.py",
    "beforeDevCommand": "python3 tools/prebuild.py"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
